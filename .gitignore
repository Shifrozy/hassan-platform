# =============================================================================
# Hassan Platform - Comprehensive Git Ignore Rules
# =============================================================================

# Personal & Unprocessed Photos / Raw Assets
My_Image.*
my_image.*
*.heic
*.raw
*.psd
personal/
private/
secrets/
*.bak
*.backup

# Proprietary Trading Strategy Source Code
*.mq4
*.mq5
*.ex4
*.ex5
*.set
*.tpl
quant_models/
trading_bots/

# Environment, Secrets & Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
credentials.json
token.json

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build & Dependency Artifacts
node_modules/
dist/
build/
.cache/
__pycache__/
*.pyc
*.pyo

# Logs & Temporary Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

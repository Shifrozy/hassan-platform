# ==============================================================================
# Algenza Backend - Environment Configuration
# ==============================================================================

# Server Port (Render automatically supplies PORT in production)
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String
# Example (Render PostgreSQL Internal or External URL):
# postgresql://algenza_user:password@dpg-xxxx-a.oregon-postgres.render.com/algenza_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algenza_db

# JWT Authentication Secret & Token Expiry
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials for Database Seeding (npm run db:seed)
ADMIN_EMAIL=admin@algenza.com
ADMIN_INITIAL_PASSWORD=Hassan@2026
ADMIN_NAME=M. Hassan

# Allowed CORS Origins (comma-separated for multiple origins)
# In production, specify https://algenza.com,https://hassan-platform.pages.dev
ALLOWED_ORIGINS=https://algenza.com,https://hassan-platform.pages.dev,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
